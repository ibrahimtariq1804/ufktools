# UFK Tools — Environment Configuration Template
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0

# Optional Custom Admin Credentials
# If left blank, defaults to admin@ufktools.com / admin123
ADMIN_EMAIL=admin@ufktools.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=UFK Administrator

# Secret key used for signing administrative session cookies (change in production)
SESSION_SECRET=ufk-tools-production-secret-encryption-key-2026-safe

# Optional Cloud PostgreSQL Database (e.g., Supabase / Neon)
# If omitted, UFK Tools automatically uses zero-cost local file-based database (.db/store.json)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/ufktools
# DATABASE_SSL=false
